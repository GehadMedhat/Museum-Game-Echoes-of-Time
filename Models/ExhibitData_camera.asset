  m_Script: {fileID: 11500000, guid: a3d2b5e5b8bd75781820de5be38f0970, type: 3}
  m_Name: ExhibitData_camera
  m_EditorClassIdentifier: Assembly-CSharp::ExhibitData
  exhibitName: THE CAMERA
  pages:
  - "The very first photograph ever taken needed\nEIGHT HOURS of sunlight to appear!\nIn
    1826, Joseph Nic\xE9phore Ni\xE9pce pointed\na box with a tiny hole at his window\nand
    waited an entire day for the image to form.\nThe blurry result is the oldest
    surviving photograph\nin the world a view of some rooftops.\n \nBack then, having
    your portrait taken was a\nhuge event. You had to sit completely still\nfor several
    minutes or the picture would blur!"
  - "Early cameras were enormous wooden boxes\nthat photographers carried everywhere
    on heavy tripods.\nEach photo used a glass plate coated in chemicals\nthere was
    no film, no memory card, nothing digital.\n \nToday you take more photos in one
    day than an entire\nVictorian family took in their whole lifetime!\nThe camera
    didn't just capture moments \nit gave us the ability to share them forever. \U0001F4F7"
  exhibitIllustration: {fileID: -4566190091907096745, guid: 80a7b008231774b719f5f40287cf6e69, type: 3}
  narratorClip: {fileID: 8300000, guid: e2d1ff22d0625f1b9bb662bddb6c71e6, type: 3}
