  m_Script: {fileID: 11500000, guid: a3d2b5e5b8bd75781820de5be38f0970, type: 3}
  m_Name: ExhibitData_music
  m_EditorClassIdentifier: Assembly-CSharp::ExhibitData
  exhibitName: THE GRAMOPHONE
  pages:
  - "Before playlists and streaming, if you wanted to hear\nyour favourite song you
    had to be there live.\nNo recordings existed at all!\n \nThat changed in 1877
    when Thomas Edison invented\na machine that could record and replay sound.\nThe
    first words ever recorded were Edison himself\nreciting: \"Mary had a little
    lamb.\"\nHe was so shocked it worked, he could barely believe it!"
  - "The gramophone played music from big round discs\ncalled records. You had to
    wind it up with a handle\nlike a toy, and a needle would trace tiny grooves\nin
    the disc to produce sound.\n \nVinyl records are still made today many music
    lovers\nsay they sound warmer and richer than digital music.\nSome things from
    the past never truly go out of style! \U0001F3B5"
  exhibitIllustration: {fileID: 5044122071167073304, guid: e972ac43a1cfde0ffb8173793500b6d2, type: 3}
  narratorClip: {fileID: 8300000, guid: d08849252088eac738b56c4871e74f3c, type: 3}
