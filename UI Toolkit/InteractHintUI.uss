/* ── InteractHintUI.uss ─────────────────────────────────────── */

.hint-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    /* pin to top-right */
    align-items: flex-end;
    justify-content: flex-start;
    padding-top: 28px;
    padding-right: 32px;
}

.hint-pill {
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);

    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
}

.hint-label {
    color: rgba(255, 255, 255, 0.92);
    font-size: 15px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
}
